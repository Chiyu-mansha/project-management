# 复制本文件为 .env 并填写(技术负责人本地使用,.env 已被 gitignore)
DASHSCOPE_API_KEY=sk-你的key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# POD-3 formal service (MVP uses the shared SQLite database)
APP_ENV=development
POD3_DB_PATH=./campus.db
POD3_STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:5173

# Shared authentication domain. The token is opaque and is validated there.
AUTH_SERVICE_URL=
AUTH_SERVICE_ME_PATH=/api/auth/me

# Shared-module adapters. Empty means read from tables in the shared SQLite DB.
ACTIVITY_SERVICE_URL=
USER_SERVICE_URL=
SEAL_SERVICE_URL=
