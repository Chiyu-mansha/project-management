# 复制本文件为 .env 并填写(技术负责人本地使用,.env 已被 gitignore)
DASHSCOPE_API_KEY=sk-你的key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# POD-3 formal service
APP_ENV=development
JWT_SECRET=请替换为至少32位随机字符串
POD3_DB_PATH=./pod3.db
POD3_STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:5173

# Optional shared-module adapters. Leave empty for the single-process MVP.
ACTIVITY_SERVICE_URL=
USER_SERVICE_URL=
SEAL_SERVICE_URL=
