# AI 网关 env 模板：复制为 .env 填写（.env 已被 gitignore，禁止提交）
# 与 backend/.env.example 保持一致

# 默认走 Mock（不调大模型）；设 1 才真正调用百炼
USE_REAL_LLM=0

# 兼容旧开关：AI_MOCK=true 等价于 USE_REAL_LLM=0（强制 Mock）
AI_MOCK=false

DASHSCOPE_API_KEY=sk-你的key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
